# --- Obligatoire (Discord Developer Portal) ---
DISCORD_TOKEN=
CLIENT_ID=

# ID de ton serveur Discord : la commande /timer apparaît instantanément.
# Laisse VIDE pour un enregistrement global (utile si le bot est invité sur plusieurs serveurs ;
# Discord peut alors mettre jusqu'à 1 h pour afficher la commande).
GUILD_ID=

# --- Optionnel ---
# Phrase annoncée par défaut
DEFAULT_MESSAGE=C'est l'heure !
# Voix (voix neurales Microsoft Edge). Ex. : fr-FR-DeniseNeural, fr-FR-HenriNeural, en-US-JennyNeural
TTS_VOICE=fr-FR-DeniseNeural
# Vitesse de parole, ex. +10% ou -10% (vide = normale)
TTS_RATE=
# Pour jouer TON propre fichier son (mp3, wav...) au lieu de la synthèse vocale, décommente :
# AUDIO_FILE=audio/mon-son.mp3
